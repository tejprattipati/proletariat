# Server only. Never prefix secrets with VITE_.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATA_DIR=.data
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://127.0.0.1:5173

# Required to unlock a deployed owner's workspace. Leave blank for local demo.
APP_ACCESS_TOKEN=
# Base64-encoded 32-byte encryption key; must remain stable across deployments.
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set with the client ID and secret when enabling Google OAuth.
# Local value: http://127.0.0.1:3001/api/google/callback
GOOGLE_REDIRECT_URI=

# Optional paid model. All four fields must be configured to enable model calls.
OPENAI_API_KEY=
OPENAI_MODEL=
MODEL_INPUT_USD_PER_MILLION=
MODEL_OUTPUT_USD_PER_MILLION=
MAX_DAILY_MODEL_TOKENS=100000

# Frontend public values. For Pages set the deployed backend's HTTPS origin.
VITE_API_URL=
GITHUB_PAGES=false
