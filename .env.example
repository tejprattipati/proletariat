# Server only. Never prefix secrets with VITE_.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATA_DIR=.data
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
FRONTEND_URL=http://127.0.0.1:5173

# Base64-encoded 32-byte encryption key; must remain stable across deployments.
TOKEN_ENCRYPTION_KEY=
# Google identity sign-in, separate from service consent. Any verified account can sign in.
# Register http://127.0.0.1:3001/api/identity/callback for local use.
GOOGLE_IDENTITY_CLIENT_ID=
GOOGLE_IDENTITY_CLIENT_SECRET=
GOOGLE_IDENTITY_REDIRECT_URI=

# Google service consent. May use the same Cloud client with its second callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Set with the client ID and secret when enabling Google OAuth.
# Local value: http://127.0.0.1:3001/api/google/callback
GOOGLE_REDIRECT_URI=

# ChatGPT plan is connected with app-owned OAuth in Connections. No API key needed.
CHATGPT_MODEL=gpt-6.1-sol

# Public chat only uses each signed-in user's connected ChatGPT plan.
# Shared API keys and CLI credentials are not used by application routes.
MAX_DAILY_MODEL_TOKENS=100000

# Operator-approved Canvas HTTPS origins, comma-separated. No token belongs here.
# Enter a Canvas token only through the signed-in connection form.
CANVAS_ALLOWED_ORIGINS=

# Frontend public values. For Pages set the deployed backend's HTTPS origin.
VITE_API_URL=
GITHUB_PAGES=false
